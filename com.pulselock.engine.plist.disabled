<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pulselock.engine</string>
  <key>WorkingDirectory</key><string>/Users/mac/pulselock</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd /Users/mac/pulselock &amp;&amp; exec npm start</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ALERT_THRESHOLD</key><string>55</string>
    <key>DEEP_DIVE_THRESHOLD</key><string>45</string>
    <key>PORT</key><string>4173</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/Users/mac/pulselock/data/engine.log</string>
  <key>StandardErrorPath</key><string>/Users/mac/pulselock/data/engine.log</string>
</dict>
</plist>
